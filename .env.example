# Oura OAuth credentials — get these from https://cloud.ouraring.com/oauth/applications
# Create a new application, then copy the Client ID and Client Secret here.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Redirect URI — must match the value you registered with Oura *exactly*.
# The default below works for the bundled local OAuth helper.
# If port 8765 is taken on your machine, change the number here AND in the
# Oura application settings to the same free port.
OURA_REDIRECT_URI=http://127.0.0.1:8765/callback

# Optional: override where tokens are stored.
# Defaults to ~/.config/oura-ring-mcp/tokens.json
# OURA_TOKEN_PATH=

# Optional: override where the local SQLite database is stored.
# Defaults to ~/.config/oura-ring-mcp/data.sqlite
# OURA_DB_PATH=

# Optional: set to "1" to enable verbose logging (still redacts secrets).
# OURA_DEBUG=

# ─── v0.6: voice ingestion (only needed if you run `npm run voice-server`) ───

# Shared secret your iOS Shortcut sends as `Authorization: Bearer <token>`.
# Generate one with `openssl rand -hex 32` and paste it into both your .env
# and your iOS Shortcut. Required to start the voice server.
VOICE_LOG_TOKEN=

# Optional: which TCP port the voice server listens on. Default 8770.
# OURA_VOICE_PORT=8770

# Optional: where the voice server appends a one-line summary per request.
# Default: ./logs/voice.log (in-repo, gitignored). Tail it with
# `tail -f logs/voice.log` in another tmux pane.
# OURA_VOICE_LOG_PATH=

# Optional: model override for the headless extraction agent. Defaults to
# claude-opus-5 (pinned in src/voice/agent.ts). Example: claude-sonnet-5
# OURA_VOICE_MODEL=

# Optional: absolute path to the compiled MCP entry the agent should spawn.
# Defaults to <project_root>/dist/index.js.
# OURA_MCP_ENTRY_PATH=

# ─── v0.7: Apple Health import (only if you run `npm run health-server`) ───

# Shared secret the iOS Shortcut (or Health Auto Export) sends as
# `Authorization: Bearer <token>` to POST /v1/health/import. Generate with
# `openssl rand -hex 32`. Intentionally separate from VOICE_LOG_TOKEN so
# the two can be rotated independently.
HEALTH_IMPORT_TOKEN=

# Optional: which TCP port the health server listens on. Default 8771.
# OURA_HEALTH_PORT=8771

# Optional: where the health server appends a one-line summary per import.
# Default: ./logs/health.log (in-repo, gitignored).
# OURA_HEALTH_LOG_PATH=

# ---------------------------------------------------------------------------
# Telegram inbound (v0.9). `npm run telegram-server` owns the bot via long
# polling, so there is no inbound port and no public endpoint.
# ---------------------------------------------------------------------------

# From @BotFather, or the token an existing briefing sender already uses.
# NOTE: whoever holds this token can also READ your inbound messages via
# getUpdates, not merely send. Treat a leak as a data incident, not an
# inconvenience.
TELEGRAM_BOT_TOKEN=

# The numeric id of YOUR private chat. Every message from any other chat is
# discarded unread — a bot username is discoverable and anyone can message it.
# Find it by messaging the bot and reading logs/telegram.log, or via @userinfobot.
TELEGRAM_ALLOWED_CHAT_ID=

# Where inbound photos and voice notes are written (0700 dir, 0600 files).
# Defaults to <db directory>/telegram-media — deliberately NOT inside the repo.
# TELEGRAM_MEDIA_DIR=

# IANA zone assumed for inbound messages: Telegram sends no timezone at all.
# Stored per row as an assumption, never as a fact the sender asserted.
# TELEGRAM_TZ=Europe/Vienna

# TELEGRAM_LOG_PATH=
