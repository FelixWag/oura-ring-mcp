{
  "name": "oura-ring-mcp",
  "version": "0.5.1",
  "description": "A Model Context Protocol server that lets Claude Code (and any MCP client) query your Oura Ring data through the official Oura API v2.",
  "type": "module",
  "bin": {
    "oura-ring-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx scripts/setup.ts",
    "oauth-login": "tsx scripts/oauth-login.ts",
    "sync": "tsx scripts/sync.ts",
    "init": "npm run setup && npm run oauth-login && npm run sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oura",
    "oura-ring",
    "claude",
    "claude-code",
    "anthropic",
    "health-data",
    "quantified-self",
    "sleep-tracking",
    "biometrics",
    "sqlite"
  ],
  "author": "Felix Wagner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixWag/oura-ring-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/FelixWag/oura-ring-mcp/issues"
  },
  "homepage": "https://github.com/FelixWag/oura-ring-mcp#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  }
}
